generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lecturer {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sets         Set[]
  sessions     Session[]
}

enum SetType {
  SURVEY
  QUESTION
}

enum DisplayMode {
  SPLIT
  COMBINED
}

enum QuestionType {
  SINGLE_SELECT
  MULTI_SELECT
}

model Set {
  id         String     @id @default(cuid())
  lecturerId String
  lecturer   Lecturer   @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  type       SetType
  title      String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  questions  Question[]
  sessions   Session[]

  @@index([lecturerId])
}

model Question {
  id        String         @id @default(cuid())
  setId     String
  set       Set            @relation(fields: [setId], references: [id], onDelete: Cascade)
  prompt    String
  type      QuestionType   @default(SINGLE_SELECT)
  order     Int
  createdAt DateTime       @default(now())
  options   AnswerOption[]

  @@index([setId])
}

model AnswerOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  order      Int

  @@index([questionId])
}

// A Session snapshots its Questions (and, for a Question Set, their correct
// answers) from the Set at start time. See ADR 0001: later edits to the Set
// must never change a Session already started from it, so SessionQuestion /
// SessionAnswerOption are copies, not references to Question / AnswerOption.
model Session {
  id          String            @id @default(cuid())
  lecturerId  String
  lecturer    Lecturer          @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  setId       String?
  set         Set?              @relation(fields: [setId], references: [id], onDelete: SetNull)
  type        SetType
  title       String
  displayMode DisplayMode
  joinCode    String            @unique
  createdAt   DateTime          @default(now())
  questions   SessionQuestion[]
  students    Student[]

  // The SessionQuestion currently open for Students to answer, and the
  // moment the first Question was ever opened (which permanently closes
  // joining, per CONTEXT.md). Not a Prisma relation: openQuestionId always
  // points at one of this Session's own SessionQuestion rows, which are
  // cascade-deleted together with it, so a cross-table FK here would only
  // add a same-transaction cascade cycle for no referential benefit.
  openQuestionId        String?
  firstQuestionOpenedAt DateTime?

  // The SessionQuestion whose Analysis is currently being displayed: set by
  // closeQuestion (moving it off openQuestionId) and cleared by nextQuestion
  // once the Lecturer advances. Never set at the same time as openQuestionId.
  closedQuestionId String?

  // Set once the Lecturer explicitly ends the Session (a one-way transition,
  // mirroring firstQuestionOpenedAt above). Unlike cancelSession, ending
  // never deletes the row: the Session's Questions, Answers, and Analyses
  // must persist for later Lecturer review (see CONTEXT.md). A non-null
  // endedAt both blocks further open/close/next/answer actions and excludes
  // this Session from the "one active Session per Lecturer" check, freeing
  // the Lecturer to start a new one.
  endedAt DateTime?

  @@index([lecturerId])
}

// A Student who has joined a Session — anonymously (Survey Session, nickname
// null) or with a nickname (Quiz Session). Nickname uniqueness is enforced
// per Session via the compound unique constraint below; Postgres treats
// multiple NULLs as distinct, so any number of anonymous Students can share
// a Survey Session without colliding.
model Student {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  nickname  String?
  createdAt DateTime @default(now())
  answers   Answer[]

  @@unique([sessionId, nickname])
  @@index([sessionId])
}

model SessionQuestion {
  id        String                @id @default(cuid())
  sessionId String
  session   Session               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  prompt    String
  type      QuestionType
  order     Int
  options   SessionAnswerOption[]
  answers   Answer[]

  @@index([sessionId])
}

model SessionAnswerOption {
  id                String              @id @default(cuid())
  sessionQuestionId String
  sessionQuestion   SessionQuestion     @relation(fields: [sessionQuestionId], references: [id], onDelete: Cascade)
  text              String
  isCorrect         Boolean
  order             Int
  selections        AnswerSelection[]

  @@index([sessionQuestionId])
}

// A Student's one-time, locked submission to an open Question (see
// CONTEXT.md's Answer definition). The compound unique constraint enforces
// "at most one Answer per Student per Question" at the database level; there
// is no update path by design — an Answer is created once and never edited.
// The Answer itself no longer points directly at a single option: it
// references a set of options via AnswerSelection below, since a
// multi-select Question's Answer can name more than one (see ticket #10).
model Answer {
  id                String            @id @default(cuid())
  sessionQuestionId String
  sessionQuestion   SessionQuestion   @relation(fields: [sessionQuestionId], references: [id], onDelete: Cascade)
  studentId         String
  student           Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt         DateTime          @default(now())
  selections        AnswerSelection[]

  @@unique([sessionQuestionId, studentId])
  @@index([studentId])
}

// One selected option within an Answer. A single-select Answer has exactly
// one row here; a multi-select Answer has one row per option the Student
// chose.
model AnswerSelection {
  id             String              @id @default(cuid())
  answerId       String
  answer         Answer              @relation(fields: [answerId], references: [id], onDelete: Cascade)
  answerOptionId String
  answerOption   SessionAnswerOption @relation(fields: [answerOptionId], references: [id], onDelete: Cascade)

  @@unique([answerId, answerOptionId])
  @@index([answerOptionId])
}
