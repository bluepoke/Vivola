generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lecturer {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  sets         Set[]
  sessions     Session[]
}

enum SetType {
  SURVEY
  QUESTION
}

enum DisplayMode {
  SPLIT
  COMBINED
}

model Set {
  id         String     @id @default(cuid())
  lecturerId String
  lecturer   Lecturer   @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  type       SetType
  title      String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  questions  Question[]
  sessions   Session[]

  @@index([lecturerId])
}

model Question {
  id        String         @id @default(cuid())
  setId     String
  set       Set            @relation(fields: [setId], references: [id], onDelete: Cascade)
  prompt    String
  order     Int
  createdAt DateTime       @default(now())
  options   AnswerOption[]

  @@index([setId])
}

model AnswerOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  order      Int

  @@index([questionId])
}

// A Session snapshots its Questions (and, for a Question Set, their correct
// answers) from the Set at start time. See ADR 0001: later edits to the Set
// must never change a Session already started from it, so SessionQuestion /
// SessionAnswerOption are copies, not references to Question / AnswerOption.
model Session {
  id          String            @id @default(cuid())
  lecturerId  String
  lecturer    Lecturer          @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  setId       String?
  set         Set?              @relation(fields: [setId], references: [id], onDelete: SetNull)
  type        SetType
  title       String
  displayMode DisplayMode
  joinCode    String            @unique
  createdAt   DateTime          @default(now())
  questions   SessionQuestion[]
  students    Student[]

  @@index([lecturerId])
}

// A Student who has joined a Session — anonymously (Survey Session, nickname
// null) or with a nickname (Quiz Session). Nickname uniqueness is enforced
// per Session via the compound unique constraint below; Postgres treats
// multiple NULLs as distinct, so any number of anonymous Students can share
// a Survey Session without colliding.
model Student {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  nickname  String?
  createdAt DateTime @default(now())

  @@unique([sessionId, nickname])
  @@index([sessionId])
}

model SessionQuestion {
  id        String                @id @default(cuid())
  sessionId String
  session   Session               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  prompt    String
  order     Int
  options   SessionAnswerOption[]

  @@index([sessionId])
}

model SessionAnswerOption {
  id                String          @id @default(cuid())
  sessionQuestionId String
  sessionQuestion   SessionQuestion @relation(fields: [sessionQuestionId], references: [id], onDelete: Cascade)
  text              String
  isCorrect         Boolean
  order             Int

  @@index([sessionQuestionId])
}
